# ==========================================
# PostNotes Environment Variables Configuration
# ==========================================

# --- Base de Datos PostgreSQL (Docker Internal) ---
DB_USER=postnotes
DB_PASSWORD=postnotes_secure_password_2026
DB_NAME=postnotes

# --- API Keys de Inteligencia Artificial ---
# Requerido para estructurar los apuntes en bloques estilo Notion (BlockNote.js)
OPENAI_API_KEY=your_openai_api_key_here

# --- Configuración Opcional ---
# Elimina los archivos de audio crudos del servidor tras completar con éxito para ahorrar espacio
# DELETE_AUDIO_AFTER_COMPLETION=true

# Opcional para transcripción híbrida ultrarrápida
GROQ_API_KEY=your_groq_api_key_here

# Optimización de CPU en ARM64 para Faster-Whisper local (4 cores es ideal para A1.Flex de Oracle)
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1

